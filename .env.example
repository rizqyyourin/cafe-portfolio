# Turso (use a local SQLite file only for development if preferred)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Better Auth: generate a long random value, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Used for canonical metadata, sitemap, and Open Graph URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage adapter credentials are chosen during implementation (Cloudinary/S3/R2).
# Keep secrets server-only; never prefix them with NEXT_PUBLIC.
# STORAGE_...
